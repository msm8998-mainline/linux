#include "msm8998-nubia-common.dtsi"

/ {
	model = "Nubia Z17s";
	compatible = "nubia,nx595j", "qcom,msm8998";
	chassis-type = "handset";
};

&framebuffer0 {
	height = <2040>;
};

&vreg_s5a_2p04 {
	regulator-min-microvolt = <1800000>;
};

&vreg_l21a_2p95 {
	regulator-min-microvolt = <2960000>;
};
